 "formats": {
  "carousel": {
   "structure": "Pick a structure from hooks.json structures; every content slide gets a different chart family",
   "motion": [],
   "hook_rule": "First slide hook <= 60 chars from a carousel hook template; slide 2 re-hooks; last slide = save/share CTA",
   "rules": [
    "Cover: one promise in 60 characters or less, one focal visual, the hook on the first slide only",
    "5 to 7 slides for a how-to or framework; up to 10 only for resource lists",
    "One idea per slide, at most about 40 words of body text; split anything longer",
    "Every content slide uses a different chart family so the swipe never feels repetitive",
    "Slide 2 re-hooks (the problem or the stakes) before the first step",
    "Numbers and charts only with figures from the source; label the unit",
    "Contrast at least 4.5:1 for body text; text never smaller than 22 px at 1080 wide",
    "Last slide: the takeaway and one action (save, share, comment or follow), with the brand CTA"
   ]
  },
  "gif": {
   "structure": "One diagram, title hook",
   "motion": [
    "staggering",
    "path tracing",
    "masking reveal",
    "looping",
    "easing"
   ],
   "hook_rule": "Title = question or curiosity line"
  },
  "reel": {
   "structure": "Hook (0-3 s), stakes, answer, how, proof, takeaway, engage",
   "motion": [
    "kinetic typography",
    "camera pan/zoom",
    "morphing",
    "animated counters",
    "particle flow",
    "parallax"
   ],
   "hook_rule": "Spoken hook + on-screen hook + visual hook chosen together"
  },
  "cover": {
   "structure": "Big hook, hero visual, avatar",
   "motion": [],
   "hook_rule": "Same family as the Reel hook; 6 words or fewer is best; safe for 4:5 crop"
  },
  "post": {
   "structure": "Hook question, bullets, CTA",
   "motion": [],
   "hook_rule": "Question or contrarian line; save/share CTA when the post has reference value"
  },
  "thumbnail": {
   "structure": "One focal point: a face, a figure, a mini diagram, or a before/after split",
   "motion": [],
   "hook_rule": "3-6 words, outlined, large; saturated mid-tone background; the face fills about a third of the frame; nothing in YouTube's bottom-right badge corner",
   "sizes": {
    "youtube": "1280x720",
    "og": "1200x630",
    "devto": "1000x420",
    "hashnode": "1600x840"
   }
  }
 }
}